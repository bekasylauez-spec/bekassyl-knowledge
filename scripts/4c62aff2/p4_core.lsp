(defun bb (e / o a b r)
  (setq o (vlax-ename->vla-object e))
  (setq r (vl-catch-all-apply 'vla-getboundingbox (list o 'a 'b)))
  (if (vl-catch-all-error-p r) nil (list (vlax-safearray->list a) (vlax-safearray->list b))))
(defun dlt (a b c f txt / ol d) (setq ol (getvar "CLAYER")) (setvar "CLAYER" "Размеры") (setvar "DIMLFAC" f)
  (command "_.DIMLINEAR" a b c) (setvar "DIMLFAC" 1.0) (setvar "CLAYER" ol)
  (if txt (progn (setq d (entget (entlast))) (entmod (subst (cons 1 txt) (assoc 1 d) d)))))
(defun dn2 (p d lay / ol) (setq ol (getvar "CLAYER")) (setvar "CLAYER" lay) (command "_.DONUT" 0 d p "") (setvar "CLAYER" ol))
(defun hl (/ e ol) (setq e (entlast) ol (getvar "CLAYER")) (setvar "CLAYER" "КЖ_Штрих")
  (command "_.-HATCH" "_P" "ANSI36" "20" "0" "_S" e "" "") (setvar "CLAYER" ol))
(defun seccp (tgt / ss i e b w h done)
  (setq ss (ssget "_X" '((0 . "SPDSSECTION"))) i 0 done nil)
  (while (and ss (< i (sslength ss)) (not done))
    (setq e (ssname ss i) b (bb e))
    (if b (progn (setq w (- (car (cadr b)) (car (car b))) h (- (cadr (cadr b)) (cadr (car b))))
      (if (and (> w h) (> (car (car b)) -393823.0) (< (car (cadr b)) -351823.0))
        (progn (cpy e (- (car tgt) (/ (+ (car (car b)) (car (cadr b))) 2.0)) (- (cadr tgt) (/ (+ (cadr (car b)) (cadr (cadr b))) 2.0)))
               (setq done T) (logm "seccp ok")))))
    (setq i (1+ i)))
  (if (not done) (logm "seccp NOT FOUND")));;BODY
