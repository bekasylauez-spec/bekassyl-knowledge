  (mklay "КЖ_Марки" "0.05") (mklay "КЖ_Таблица" "0.05") (mklay "КЖ_Таблица_т" "0.30") (mklay "диам20" "0.40") (mklay "диам12" "0.40") (mklay "диам8" "0.30")
  (if (tblsearch "DIMSTYLE" "СПДС") (command "_.-DIMSTYLE" "_R" "СПДС"))
