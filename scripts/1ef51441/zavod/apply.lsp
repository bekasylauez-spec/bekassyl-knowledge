(defun ap:split (s sep / r i)
  (setq r '())
  (while (setq i (vl-string-search sep s))
    (setq r (cons (substr s 1 i) r) s (substr s (+ i 1 (strlen sep)))))
  (reverse (cons s r)))
(defun ap:nums (s) (mapcar 'atof (vl-remove "" (ap:split s " "))))
(defun ap:del (hs / e)
  (foreach h (vl-remove "" (ap:split hs " "))
    (if (and (setq e (handent h)) (entget e)) (entdel e))))
(defun ap:layer (name clr lt lw)
  (if (not (tblsearch "LAYER" name))
    (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord") '(100 . "AcDbLayerTableRecord")
                   (cons 2 name) '(70 . 0) (cons 62 clr) (cons 6 lt) (cons 370 lw)))))
(defun ap:setup (k / nm)
  (setvar "CMDECHO" 0) (setvar "OSMODE" 0)
  (if (not (tblsearch "STYLE" "���� 2.304"))
    (entmake '((0 . "STYLE") (100 . "AcDbSymbolTableRecord") (100 . "AcDbTextStyleTableRecord")
               (2 . "���� 2.304") (70 . 0) (40 . 0.0) (41 . 1.0) (50 . 0.0) (71 . 0) (42 . 2.5) (3 . "isocpeui.ttf") (4 . ""))))
  (if (not (tblsearch "LTYPE" "ACAD_ISO04W100")) (command "_.-LINETYPE" "_L" "ACAD_ISO04W100" "acadiso.lin" ""))
  (ap:layer "��_�������" 7 "Continuous" 18)
  (ap:layer "��_���" 7 "ACAD_ISO04W100" 18)
  (setq nm (strcat "���� 1-" (itoa k)))
  (if (not (tblsearch "DIMSTYLE" nm))
    (progn
      (setvar "DIMSCALE" (float k)) (setvar "DIMTXT" 2.5) (setvar "DIMASZ" 2.5) (setvar "DIMGAP" 0.63)
      (setvar "DIMEXO" 0.63) (setvar "DIMEXE" 1.25) (setvar "DIMTAD" 1) (setvar "DIMTIH" 0) (setvar "DIMTOH" 0)
      (setvar "DIMTMOVE" 1) (setvar "DIMTXSTY" "���� 2.304") (setvar "DIMBLK" "_Oblique") (setvar "DIMLFAC" 1.0)
      (setvar "DIMDEC" 0) (setvar "DIMLUNIT" 2) (setvar "DIMZIN" 8) (setvar "DIMDLE" 0.0) (setvar "DIMCLRD" 256)
      (setvar "DIMCLRE" 256) (setvar "DIMCLRT" 256) (setvar "DIMSE1" 0) (setvar "DIMSE2" 0) (setvar "DIMTOFL" 1)
      (setvar "DIMATFIT" 3) (setvar "DIMRND" 0.0)
      (command "_.-DIMSTYLE" "_S" nm)))
  (command "_.-DIMSTYLE" "_R" nm)
  nm)
(defun ap:dim (f / n p1 p2 pl rot e ed se)
  ;; f = (tag nums style flags textpos dels)
  (setq n (ap:nums (nth 1 f)) se (ap:nums (nth 3 f)))
  (setq p1 (list (nth 0 n) (nth 1 n)) p2 (list (nth 2 n) (nth 3 n)) pl (list (nth 4 n) (nth 5 n))
        rot (nth 6 n))
  (ap:del (nth 5 f))
  (setvar "DIMSE1" (if (= (car se) 0.0) 1 0)) (setvar "DIMSE2" (if (= (cadr se) 0.0) 1 0))
  (setvar "CLAYER" "��_�������")
  (command "_.DIMLINEAR" p1 p2 "_R" rot pl)
  (setq e (entlast) ed (entget e))
  (if (/= (nth 4 f) "-")
    (progn
      (setq n (ap:nums (nth 4 f)))
      (setq ed (subst (list 11 (car n) (cadr n) 0.0) (assoc 11 ed) ed))
      (setq ed (subst (cons 70 (logior 128 (cdr (assoc 70 ed)))) (assoc 70 ed) ed))
      (entmod ed) (entupd e)))
  (setvar "DIMSE1" 0) (setvar "DIMSE2" 0))
(defun ap:tw (ed / b) (setq b (textbox ed)) (if b (- (car (cadr b)) (car (car b))) 0.0))
(defun ap:txt (f / e ed n w0 w1 wf)
  ;; TXT handle height: own font, width 0.9, never longer than the original text
  (if (and (setq e (handent (nth 1 f))) (setq ed (entget e)))
    (progn
      (setq n (atof (nth 2 f)) w0 (ap:tw ed))
      (setq ed (subst (cons 7 "���� 2.304") (assoc 7 ed) ed))
      (setq ed (subst (cons 40 n) (assoc 40 ed) ed))
      (setq ed (subst (cons 41 0.9) (assoc 41 ed) ed))
      (setq ed (subst (cons 51 0.0) (assoc 51 ed) ed))
      (setq w1 (ap:tw ed))
      (if (and (> w0 0) (> w1 (* 1.02 w0)))
        (progn (setq wf (max 0.55 (* 0.9 (/ w0 w1))))
               (setq ed (subst (cons 41 wf) (assoc 41 ed) ed))))
      (entmod ed))))
(defun ap:lt (f / e ed)
  (if (and (setq e (handent (nth 1 f))) (setq ed (entget e)))
    (progn
      (setq ed (subst (cons 8 "��_���") (assoc 8 ed) ed))
      (if (assoc 48 ed) (setq ed (subst (cons 48 (atof (nth 2 f))) (assoc 48 ed) ed)) (setq ed (append ed (list (cons 48 (atof (nth 2 f)))))))
      (entmod ed))))
(defun c:APL ( / fh ln f k cnt)
  (setq k (atoi (getenv "APK")))
  (ap:setup k)
  (setq fh (open (getenv "APOPS") "r") cnt 0)
  (while (setq ln (read-line fh))
    (setq f (ap:split ln "\t"))
    (cond ((= (car f) "DIM") (ap:dim f))
          ((= (car f) "TXT") (ap:txt f))
          ((= (car f) "LT") (ap:lt f))
          ((= (car f) "DEL") (ap:del (nth 1 f))))
    (setq cnt (1+ cnt)))
  (close fh)
  (setvar "CLAYER" "0")
  (princ (strcat "\nAPL ops: " (itoa cnt) " PSLTSCALE=" (itoa (getvar "PSLTSCALE")) " LTSCALE=" (rtos (getvar "LTSCALE") 2 3)))
  (command "_.SAVEAS" "2018" (getenv "APOUT"))
  (princ))
